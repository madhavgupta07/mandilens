# ---------------------------------------------------------------------------
# MandiLens environment configuration
# Copy this file to `.env.local` for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas works; see README "MongoDB setup").
# For a zero-config local dev database run `pnpm db:dev` and use the printed URI.
MONGODB_URI="mongodb://127.0.0.1:27017/mandilens"

# Secret used to sign session JWTs. Must be >= 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public base URL of the app (used for links, cookies and email callbacks).
APP_URL="http://localhost:3000"

# --- Open-source AI model provider (optional) ------------------------------
# AI_PROVIDER selects the backend. One of: auto | gemma | openai | ollama | none
#   auto   -> use gemma/openai if a key is set, else ollama if reachable, else none
#   gemma  -> Google AI Studio, OpenAI-compatible endpoint serving Gemma (open weights)
#   openai -> any OpenAI-compatible chat-completions endpoint (Groq, OpenRouter,
#             DigitalOcean Gradient, vLLM, LM Studio, ...)
#   ollama -> local Ollama server
#   none   -> deterministic fallback (no model; rule-based assistant, clearly labelled)
AI_PROVIDER="auto"

# Google AI Studio (free key at https://aistudio.google.com/apikey).
# Serves Gemma open-weight models through an OpenAI-compatible API.
OPEN_MODEL_API_KEY=""
OPEN_MODEL_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
OPEN_MODEL_MODEL="gemma-3-12b-it"

# Generic OpenAI-compatible provider override (takes precedence over base URL above
# when OPEN_MODEL_BASE_URL points elsewhere, e.g. https://api.groq.com/openai/v1).
# Examples:
#   Groq:          https://api.groq.com/openai/v1        model llama-3.3-70b-versatile
#   OpenRouter:    https://openrouter.ai/api/v1          model google/gemma-3-27b-it:free
#   DO Gradient:   https://inference.do-ai.run/v1        model llama3.3-70b-instruct
AI_REQUEST_TIMEOUT_MS="45000"
AI_MAX_TOOL_STEPS="6"

# --- Local Ollama (optional alternative) -----------------------------------
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma3:4b"

# --- Government open data (optional) ---------------------------------------
# Free API key from https://data.gov.in (My Account -> API Keys).
# Powers the AGMARKNET daily mandi price ingestion adapter.
AGRICULTURAL_DATA_API_KEY=""
AGMARKNET_RESOURCE_ID="9ef84268-d588-465a-a308-a864a43d0070"
AGMARKNET_DEFAULT_STATE="Bihar"

# --- Background jobs (optional) --------------------------------------------
# Shared secret required by the ingestion cron endpoint (/api/admin/ingestion/run).
INGESTION_CRON_SECRET=""

# --- Optional email notifications (not required for core features) ----------
# If unset, notifications are delivered in-app only.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="notifications@example.com"

# --- Demo data -------------------------------------------------------------
# Enables the seeded, clearly-labelled demo dataset (see `pnpm seed:demo`).
DEMO_MODE="true"
